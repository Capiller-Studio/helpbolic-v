footer.footer
  .footer-left
    .footer-logo
      - if @current_portal.logo.attached?
        = picture_tag @current_portal.logo, img_class: "brand-logo"
      - else
        svg fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="24" height="24"
          path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
      span = @current_portal.name
  .footer-right
    p = raw(@current_portal.footer_text.presence || "&copy; #{Time.current.year} #{@current_portal.account.name}. All rights reserved.")
