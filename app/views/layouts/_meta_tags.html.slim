link rel="canonical" href=canonical_url
meta name="description" content=meta_description
meta name="keywords" content=meta_keywords
meta name="robots" content=robots_content

- hreflang_links.each do |hl|
  link rel="alternate" hreflang=hl[:locale] href=hl[:url]

/! Open Graph
meta property="og:site_name" content=(@current_portal&.name || "Deskbolic")
meta property="og:title" content=meta_title
meta property="og:description" content=meta_description
meta property="og:type" content=meta_og_type
meta property="og:url" content=canonical_url
- if meta_image.present?
  meta property="og:image" content=meta_image
  meta property="og:image:alt" content=meta_title
meta property="og:locale" content=I18n.locale

/! Twitter Card
meta name="twitter:card" content="summary_large_image"
meta name="twitter:title" content=meta_title
meta name="twitter:description" content=meta_description
- if meta_image.present?
  meta name="twitter:image" content=meta_image
  meta name="twitter:image:alt" content=meta_title

/! Favicons
= favicon_link_tag portal_favicon_url, rel: "icon", type: "image/png"
= favicon_link_tag portal_favicon_url, rel: "apple-touch-icon", type: "image/png"
