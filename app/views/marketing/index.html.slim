.marketing-page
  header.marketing-header
    .marketing-logo-wrapper
      = image_tag "logo.svg", alt: t("marketing.brand"), class: "marketing-logo"
    nav.marketing-nav
      a href="http://deskbolic.localhost:3000" = t("marketing.nav.features")
      a href="http://deskbolic.localhost:3000" = t("marketing.nav.pricing")
      a href="http://deskbolic.localhost:3000" = t("marketing.nav.docs")
    .marketing-actions
      a.marketing-login href="http://deskbolic.localhost:3000/login" = t("marketing.nav.login")
      a.marketing-signup href="http://deskbolic.localhost:3000/signup" = t("marketing.nav.signup")

  main.marketing-main
    .marketing-hero
      .marketing-badge
        .badge-dot-wrapper
          span.badge-dot-ping
          span.badge-dot
        = t("marketing.hero.badge")
      
      h1.marketing-title
        = t("marketing.hero.title_start")
        span.marketing-title-highlight = t("marketing.hero.title_highlight")

      p.marketing-description
        = t("marketing.hero.description")

      .marketing-cta-group
        a.btn-primary-marketing href="http://deskbolic.localhost:3000"
          = t("marketing.cta.primary")
          svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            line x1="5" y1="12" x2="19" y2="12"
            polyline points="12 5 19 12 12 19"
        
        a.btn-secondary-marketing href="http://deskbolic.localhost:3000"
          = t("marketing.cta.secondary")

  footer.marketing-footer
    p = t("marketing.footer.copyright", year: Time.current.year)
