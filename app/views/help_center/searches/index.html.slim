- content_for :title do
  = t("help_center.search.title_with_query", query: @query, portal: @current_portal.name)

.search-results-page
  .container
    .search-results-header
      .breadcrumb
        = link_to t("help_center.common.home"), root_path
        span.breadcrumb-separator ›
        span.breadcrumb-current = t("help_center.search.title")
      
      h1 = t("help_center.search.title")
      
      .search-form-container data-controller="search"
        input.search-input-large type="text" value=@query placeholder=t("help_center.search.search_again") data-action="keyup->search#query" data-search-target="input"
        .search-dropdown.hidden data-search-target="results"

    .search-results-body
      - if @query.blank?
        .search-empty-state
          i data-lucide="search" class="empty-state-icon"
          h2 = t("help_center.search.enter_search_term")
          p = t("help_center.search.enter_search_term_desc")
          
      - elsif @articles.empty? && @categories.empty?
        .search-empty-state
          i data-lucide="search-x" class="empty-state-icon"
          h2 = t("help_center.search.no_results", query: @query)
          p = t("help_center.search.no_results_desc")
          = link_to t("help_center.search.browse_categories"), root_path, class: "btn-secondary"

      - else
        .search-results-stats
          == t("help_center.search.showing_results", query: ERB::Util.html_escape(@query))
        
        .search-results-grid
          .search-main-column
            - if @articles.any?
              h3.search-section-title = t("help_center.search.articles_count", count: @pagy_articles.count)
              .search-article-list
                - @articles.with_highlights.each do |article, highlights|
                  = link_to article_path(article), class: "search-result-card" do
                    h4 = raw(highlights&.dig("translations.title") || article.title)
                    - if highlights&.dig("translations.content")
                      p = raw(highlights["translations.content"])
                    - else
                      p = strip_tags(article.content).to_s.truncate(150)
                    .search-result-meta
                      span.meta-badge = t("help_center.common.article")
                      - if article.primary_category
                        span.meta-category = t("help_center.search.in_category", category: article.primary_category.name)
                      
              .search-pagination
                == pagy_nav(@pagy_articles)

          .search-sidebar-column
            - if @categories.any?
              h3.search-section-title = t("help_center.common.collections")
              .search-category-list
                - @categories.each do |cat|
                  = link_to category_path(cat), class: "search-category-card" do
                    .category-icon
                      i data-lucide=(cat.icon_key || "folder")
                    .category-content
                      h4 = cat.name
                      p = strip_tags(cat.description.to_s).truncate(80)
            
            - if @current_portal.show_contact_form?
              .search-help-box
                h4 = t("help_center.common.still_need_help")
                p = t("help_center.search.support_box_desc")
                = link_to t("help_center.common.contact_support"), contact_path, class: "btn-primary w-full"
